# AHDORA API — example environment. Copy to `.env` and fill in real values.
# NEVER commit a real `.env` — it is gitignored. Placeholders only here.

# development | test | production
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (required). Use a database user with
# least privilege, and restrict Atlas network access to your server IP.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Public origin of the deployed frontend (used for CORS + email links).
FRONTEND_ORIGIN=http://localhost:5173

# Extra allowed origins, comma-separated (e.g. a same-Wi-Fi phone IP
# for mobile testing, or the production domain). FRONTEND_ORIGIN is
# always allowed; localhost:5173 is allowed automatically in dev.
CORS_ORIGINS=

# Session cookie name and lifetime (days, max 30).
SESSION_COOKIE_NAME=ahdora_session
SESSION_TTL_DAYS=7

# CSRF cookie name.
CSRF_COOKIE_NAME=ahdora_csrf

# ---- Email (SMTP) — OPTIONAL ----
# When any of these is missing, email verification and password reset
# answer 503 "email sending is not configured" instead of pretending
# an email was sent. Set all five to enable email for real.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=apikey-or-username
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=AHDORA <no-reply@example.com>
